# Cloudinary
# =====================================================

# Cloudinary account credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# Database seeding
# =====================================================

# Password assigned to the seeded administrator account
SEED_ADMIN_PASSWORD=

# Password assigned to the seeded member account
SEED_MEMBER_PASSWORD=

# =====================================================
# Monitoring
# =====================================================

